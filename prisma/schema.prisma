generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id                       String        @id @default(cuid())
  name                     String
  slug                     String        @unique
  appId                    String        @unique @map("app_id")
  appSecret                String        @map("app_secret")
  status                   AppStatus     @default(ACTIVE)
  version                  String?
  description              String?
  
  hwidLock                 Boolean       @default(true)
  forceHwid                Boolean       @default(false)
  vpnBlock                 Boolean       @default(false)
  maintenanceMode          Boolean       @default(false)
  minHwidLength            Int           @default(16)
  sessionExpirationMinutes Int           @default(1440)
  minUsernameLength        Int           @default(3)
  hwidResetCooldownMinutes Int           @default(0)

  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  users                    User[]
  licenses                 License[]
  sessions                 Session[]
  variables                Variable[]
  credentials              ApplicationCredential[]
  blacklistRules           BlacklistRule[]

  @@map("applications")
}

enum AppStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

model ApplicationCredential {
  id         String      @id @default(cuid())
  publicId   String      @unique
  secretHash String
  status     String      @default("ACTIVE")
  appId      String
  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  hwidHash     String?
  pcName       String?
  lastIp       String?
  status       String      @default("ACTIVE")
  banReason    String?
  bannedUntil  DateTime?
  lastLoginAt  DateTime?
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  licenses     License[]
  sessions     Session[]
}

model License {
  id               String      @id @default(cuid())
  key              String      @unique
  appId            String
  app              Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           String      @default("UNUSED")
  hwidHash         String?
  durationDays     Int?
  activatedAt      DateTime?
  expiresAt        DateTime?
  lastValidationAt DateTime?
  lastIp           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([key])
  @@index([userId])
  @@index([appId])
}

model Session {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId        String
  app          Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  hwidHash     String?
  pcName       String?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  lastActivity DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model Variable {
  id        String      @id @default(cuid())
  key       String
  value     String
  appId     String
  app       Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([appId, key])
}

model BlacklistRule {
  id        String       @id @default(cuid())
  type      String
  value     String
  reason    String?
  appId     String?
  app       Application? @relation(fields: [appId], references: [id], onDelete: Cascade)
  kind      String       @default("BLACKLIST")
  createdBy String?
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([type, value])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  actorType  String?
  actorId    String?
  ip         String?
  hwid       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}