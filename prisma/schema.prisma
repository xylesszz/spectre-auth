// Schema seguro para SPECTRE AUTH
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id        String   @id @default(cuid())
  name      String
  appId     String   @unique // Público
  appSecret String   // Hashed (bcrypt/argon2)
  createdAt DateTime @default(now())
  licenses  License[]
  variables Variable[]
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String    // Hashed (Argon2id)
  hwid      String?   // Hashed
  ip        String?
  status    String    @default("ACTIVE") // ACTIVE, BANNED, LOCKED
  appId     String
  app       Application @relation(fields: [appId], references: [id])
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model License {
  id         String   @id @default(cuid())
  key        String   @unique // Cryptographically secure random
  appId      String
  app        Application @relation(fields: [appId], references: [id])
  userId     String?  // Null if unassigned
  user       User?    @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  status     String   @default("INACTIVE") // INACTIVE, ACTIVE, REVOKED
  hwid       String?  // Bound HWID hash
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // High entropy random string
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Variable {
  id        String   @id @default(cuid())
  key       String
  value     String
  appId     String
  app       Application @relation(fields: [appId], references: [id])
  @@unique([appId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g., "LOGIN_FAILED", "LICENSE_REVOKED"
  ip        String?
  hwid      String?
  metadata  Json?
  createdAt DateTime @default(now())
}